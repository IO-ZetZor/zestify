#!/usr/bin/env python3
"""Canonical Zesti executable.

Adds the repository root to ``sys.path`` so the ``zesti`` package imports
regardless of how ``bin/zesti`` is invoked, then delegates to
``zesti.cli.main()`` preserving exit codes 0/1/2.
"""

import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if REPO not in sys.path:
    sys.path.insert(0, REPO)

from zesti.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
